APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=webapp_mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=webapp_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=webapp_mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

EMBEDDING_URL=http://webapp_embeddings
EMBEDDING_DIMENSIONS=384

QDRANT_URL=http://webapp_qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Default model per provider, used when a chatbot has none set.
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-v4-flash

LLM_TIMEOUT=60
LLM_CONNECT_TIMEOUT=5
LLM_MAX_TOKENS=1024

CHAT_HISTORY_LIMIT=10
CHAT_TOP_K=6
CHAT_SCORE_THRESHOLD=0.5

WIDGET_TOKEN_TTL_MINUTES=240
WIDGET_MAX_MESSAGE_LENGTH=2000
WIDGET_REPLY_LOCK_SECONDS=150
WIDGET_DAILY_QUOTA=2000
WIDGET_LIMIT_CONFIG_PER_MINUTE_IP=60
WIDGET_LIMIT_SESSIONS_PER_MINUTE_IP=20
WIDGET_LIMIT_MESSAGES_PER_MINUTE_CONVERSATION=10
WIDGET_LIMIT_MESSAGES_PER_MINUTE_IP=30
WIDGET_LIMIT_BROADCAST_AUTH_PER_MINUTE_IP=60
WIDGET_STREAM_FLUSH_CHARS=20
WIDGET_STREAM_FLUSH_MS=40

PDFTOTEXT_PATH=/usr/bin/pdftotext
